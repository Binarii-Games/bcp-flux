# Whitespace only. Brace style varies by directory here and the surrounding
# file wins, so there is deliberately no formatter config — see CONTRIBUTING.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.yml]
indent_size = 2
